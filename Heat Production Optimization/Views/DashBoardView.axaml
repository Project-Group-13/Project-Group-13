<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:dialogs="using:Avalonia.Dialogs"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:viewModels="clr-namespace:Heat_Production_Optimization.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="Heat_Production_Optimization.Views.DashBoardView"
        x:CompileBindings="False">

    <Design.DataContext>
        <viewModels:MainWindowViewModel/>
    </Design.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="Dashboard" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Optimizer snapshot for the selected hour." Foreground="#6B7280" FontSize="14"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#6B7280" FontSize="12"/>
            </Grid>

            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Optimizer Inputs" FontWeight="SemiBold" Foreground="#111827"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Date:" VerticalAlignment="Center" Foreground="#6B7280"/>
                        <ComboBox ItemsSource="{Binding AvailableYears}"
                                  SelectedItem="{Binding SelectedYear}"
                                  Width="90"/>
                        <ComboBox ItemsSource="{Binding AvailableMonths}"
                                  SelectedItem="{Binding SelectedMonth}"
                                  Width="70"/>
                        <ComboBox ItemsSource="{Binding AvailableDays}"
                                  SelectedItem="{Binding SelectedDay}"
                                  Width="70"/>
                        <TextBlock Text="Hour:" VerticalAlignment="Center" Foreground="#6B7280"/>
                        <ComboBox ItemsSource="{Binding Hours}"
                                  SelectedItem="{Binding SelectedHour}"
                                  Width="70"/>
                        <Button Command="{Binding RefreshDashboardCommand}">Run Optimizer</Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <WrapPanel>
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="12" MinWidth="190" Margin="0,0,12,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Active Units" Foreground="#6B7280" FontSize="12"/>
                        <TextBlock Text="{Binding ActiveUnitsCount}" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="{Binding ActiveUnitsSummary}" Foreground="#9CA3AF" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="12" MinWidth="190" Margin="0,0,12,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Heat Demand" Foreground="#6B7280" FontSize="12"/>
                        <TextBlock Text="{Binding HeatDemand, StringFormat={}{0:F2} MWh}" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="Selected hour" Foreground="#9CA3AF" FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="12" MinWidth="190" Margin="0,0,12,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Total Heat Produced" Foreground="#6B7280" FontSize="12"/>
                        <TextBlock Text="{Binding TotalHeatProduced, StringFormat={}{0:F2} MWh}" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="Sum of active units" Foreground="#9CA3AF" FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="12" MinWidth="210" Margin="0,0,12,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Total Net Production Cost" Foreground="#6B7280" FontSize="12"/>
                        <TextBlock Text="{Binding TotalNetProductionCost, StringFormat={}{0:F0} DKK}" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="Sum of unit costs" Foreground="#9CA3AF" FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="12" MinWidth="190" Margin="0,0,12,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Total CO2 Emission" Foreground="#6B7280" FontSize="12"/>
                        <TextBlock Text="{Binding TotalCo2Emissions, StringFormat={}{0:F1} kg}" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="Unit emissions" Foreground="#9CA3AF" FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="12" MinWidth="190" Margin="0,0,12,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Net Cost / MWh" Foreground="#6B7280" FontSize="12"/>
                        <TextBlock Text="{Binding NetCostPerMwh, StringFormat={}{0:F2} DKK}" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="Weighted average" Foreground="#9CA3AF" FontSize="11"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="14">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Active Units" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Grid.Column="1" Text="{Binding ActiveUnitsSummary}" Foreground="#6B7280" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <Grid ColumnDefinitions="2*,*,*,*" Margin="0,4,0,0">
                        <TextBlock Text="Unit" Foreground="#6B7280" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="Heat" Foreground="#6B7280" FontSize="12" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="Net Cost" Foreground="#6B7280" FontSize="12" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="CO2" Foreground="#6B7280" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ActiveUnits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="2*,*,*,*" Margin="0,2,0,2">
                                    <TextBlock Text="{Binding UnitName}" Foreground="#111827"/>
                                    <TextBlock Grid.Column="1" Text="{Binding HeatProduced, StringFormat={}{0:F2} MWh}" HorizontalAlignment="Right" Foreground="#111827"/>
                                    <TextBlock Grid.Column="2" Text="{Binding NetCost, StringFormat={}{0:F0} DKK}" HorizontalAlignment="Right" Foreground="#111827"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Co2Emissions, StringFormat={}{0:F1} kg}" HorizontalAlignment="Right" Foreground="#111827"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No active units for this hour." IsVisible="{Binding ShowEmptyState}" Foreground="#6B7280" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Data Management" FontWeight="SemiBold" Foreground="#111827"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding UploadSourceDataFileCommand}">Upload Source Data</Button>
                        <Button Command="{Binding UploadUnitsFileCommand}">Upload Production Units</Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</UserControl>
