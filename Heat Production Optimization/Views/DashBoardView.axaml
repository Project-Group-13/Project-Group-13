<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:dialogs="using:Avalonia.Dialogs"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:viewModels="clr-namespace:Heat_Production_Optimization.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="Heat_Production_Optimization.Views.DashBoardView"
        x:CompileBindings="False">

    <Design.DataContext>
        <viewModels:MainWindowViewModel/>
    </Design.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="Dashboard" Classes="h1" />
                    <TextBlock Text="Optimizer snapshot for the selected hour." Classes="subtitle" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" Classes="muted" />
            </Grid>

            <Border Classes="panel" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Optimizer Inputs" Classes="h2" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Date:" VerticalAlignment="Center" Classes="label" />
                        <ComboBox ItemsSource="{Binding AvailableYears}"
                                  SelectedItem="{Binding SelectedYear}"
                                  Width="90"/>
                        <ComboBox ItemsSource="{Binding AvailableMonths}"
                                  SelectedItem="{Binding SelectedMonth}"
                                  Width="70"/>
                        <ComboBox ItemsSource="{Binding AvailableDays}"
                                  SelectedItem="{Binding SelectedDay}"
                                  Width="70"/>
                        <TextBlock Text="Hour:" VerticalAlignment="Center" Classes="label" />
                        <ComboBox ItemsSource="{Binding Hours}"
                                  SelectedItem="{Binding SelectedHour}"
                                  Width="70"/>
                        <Button Classes="primary" Command="{Binding RefreshDashboardCommand}">Run Optimizer</Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <WrapPanel>
                <Border Classes="card" Padding="12" MinWidth="190" Margin="0,0,12,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Active Units" Classes="label" />
                        <TextBlock Text="{Binding ActiveUnitsCount}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="{Binding ActiveUnitsSummary}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="12" MinWidth="190" Margin="0,0,12,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Heat Demand" Classes="label" />
                        <TextBlock Text="{Binding HeatDemand, StringFormat={}{0:F2} MWh}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Selected hour" Classes="muted" />
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="12" MinWidth="190" Margin="0,0,12,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Total Heat Produced" Classes="label" />
                        <TextBlock Text="{Binding TotalHeatProduced, StringFormat={}{0:F2} MWh}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Sum of active units" Classes="muted" />
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="12" MinWidth="210" Margin="0,0,12,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Total Net Production Cost" Classes="label" />
                        <TextBlock Text="{Binding TotalNetProductionCost, StringFormat={}{0:F0} DKK}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Sum of unit costs" Classes="muted" />
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="12" MinWidth="190" Margin="0,0,12,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Total CO2 Emission" Classes="label" />
                        <TextBlock Text="{Binding TotalCo2Emissions, StringFormat={}{0:F1} kg}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Unit emissions" Classes="muted" />
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="12" MinWidth="190" Margin="0,0,12,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Net Cost / MWh" Classes="label" />
                        <TextBlock Text="{Binding NetCostPerMwh, StringFormat={}{0:F2} DKK}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Weighted average" Classes="muted" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Border Classes="card" Padding="14">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Active Units" Classes="h2" />
                        <TextBlock Grid.Column="1" Text="{Binding ActiveUnitsSummary}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <Grid ColumnDefinitions="2*,*,*,*" Margin="0,4,0,0">
                        <TextBlock Text="Unit" Classes="label" />
                        <TextBlock Grid.Column="1" Text="Heat" Classes="label" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="Net Cost" Classes="label" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="CO2" Classes="label" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ActiveUnits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="2*,*,*,*" Margin="0,2,0,2">
                                    <TextBlock Text="{Binding UnitName}" />
                                    <TextBlock Grid.Column="1" Text="{Binding HeatProduced, StringFormat={}{0:F2} MWh}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="{Binding NetCost, StringFormat={}{0:F0} DKK}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{Binding Co2Emissions, StringFormat={}{0:F1} kg}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No active units for this hour." IsVisible="{Binding ShowEmptyState}" Classes="muted" />
                </StackPanel>
            </Border>

            <Border Classes="panel" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Data Management" Classes="h2" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="primary" Command="{Binding UploadSourceDataFileCommand}">Upload Source Data</Button>
                        <Button Command="{Binding UploadUnitsFileCommand}">Upload Production Units</Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</UserControl>
