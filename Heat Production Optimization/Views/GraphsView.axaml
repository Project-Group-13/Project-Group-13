<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:viewModels="clr-namespace:Heat_Production_Optimization.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="Heat_Production_Optimization.Views.GraphsView"
        x:CompileBindings="False">

    <Design.DataContext>
        <viewModels:MainWindowViewModel/>
    </Design.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="Graphs" Classes="h1" />
                <TextBlock Text="Explore production trends and schedules." Classes="subtitle" />
            </StackPanel>

            <Border Classes="panel" Padding="12">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Select a graph:" VerticalAlignment="Center" Classes="label" />
                        <ComboBox ItemsSource="{Binding GraphOptions}" 
                                  SelectedItem="{Binding SelectedGraph}"
                                  Width="260"
                                  HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsRangeGraphSelected}">
                        <TextBlock Text="Range:" VerticalAlignment="Center" Classes="label" />
                        <ComboBox ItemsSource="{Binding AvailableDateRange}"
                                  SelectedItem="{Binding SelectedRangeStart}"
                                  Width="140">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding, StringFormat={}{0:yyyy-MM-dd}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="to" VerticalAlignment="Center" Classes="label" />
                        <ComboBox ItemsSource="{Binding AvailableDateRange}"
                                  SelectedItem="{Binding SelectedRangeEnd}"
                                  Width="140">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding, StringFormat={}{0:yyyy-MM-dd}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Group by:" VerticalAlignment="Center" Classes="label" />
                        <ComboBox ItemsSource="{Binding TimeGroupingOptions}"
                                  SelectedItem="{Binding SelectedTimeGrouping}"
                                  Width="90"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsScheduleGraphSelected}">
                        <TextBlock Text="Schedule date:" VerticalAlignment="Center" Classes="label" />
                        <ComboBox ItemsSource="{Binding AvailableYears}"
                                  SelectedItem="{Binding SelectedYear}"
                                  Width="90"/>
                        <ComboBox ItemsSource="{Binding AvailableMonths}"
                                  SelectedItem="{Binding SelectedMonth}"
                                  Width="70"/>
                        <ComboBox ItemsSource="{Binding AvailableDays}"
                                  SelectedItem="{Binding SelectedDay}"
                                  Width="70"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="12">
                <lvc:CartesianChart Series="{Binding Series}" 
                                    XAxes="{Binding XAxes}" 
                                    YAxes="{Binding YAxes}" 
                                    Title="{Binding ChartTitle}"
                                    LegendTextPaint="#111111"
                                    LegendBackgroundPaint="#00FFFFFF"
                                    Background="White"
                                    Height="360"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>